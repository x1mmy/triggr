TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
PIPEDREAM_DEMO_SMS_WEBHOOK_URL=https://eoox4atsq75w3h.m.pipedream.net

# Onboarding submit
BLOB_READ_WRITE_TOKEN=

# Notion — integration must be connected to the Clients database
NOTION_API_KEY=
# UUID only (query strings like ?v=... are stripped if you paste a full Notion URL)
NOTION_CLIENTS_DATABASE_ID=
# Optional: property names (defaults match Triggr Clients DB). Set VAR= (empty) to skip sending that column.
NOTION_TITLE_PROPERTY=Client Name
NOTION_NOTES_PROPERTY=Notes
NOTION_BUSINESS_NAME_PROPERTY=Business Name
NOTION_FORM_SUBMITTED_PROPERTY=Form Submitted
NOTION_PHONE_PROPERTY=Phone
NOTION_SERVICE_PROPERTY=Service
NOTION_STATUS_PROPERTY=Status
# Notion "Status" column: native Status type (default). Set true if your Status column is a Select instead.
# NOTION_STATUS_AS_SELECT=true
# If your onboarding option text differs (default Onboarding)
# NOTION_ONBOARDING_STATUS=Onboarding

# Linear GraphQL API (https://linear.app/settings/api)
LINEAR_API_KEY=
# Team key (e.g. TRGR) or team UUID — both work
LINEAR_TEAM_ID=TRGR
LINEAR_ASSIGNEE_ID=
# Project slug from URL (e.g. client-work-abc123) or project UUID
LINEAR_PROJECT_ID=
LINEAR_WORKFLOW_STATE_TODO_ID=
